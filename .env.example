# MongoDB connection string (MongoDB Atlas or local)
# Example Atlas format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/book-manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/book-manager

# Secret used to sign JWTs — use a long random string in production
# You can generate one with: openssl rand -base64 32
JWT_SECRET=replace_this_with_a_long_random_secret

# Set to "production" when deploying (Vercel sets this automatically)
NODE_ENV=development
